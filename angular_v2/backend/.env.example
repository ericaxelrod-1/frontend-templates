# Copy to .env and edit. Only *.example files are committed; a real .env holds
# secrets and is git-ignored.
#
# Every value below is read once, in src/config/environment.ts. A missing or
# malformed value stops the process at bootstrap with the full list of problems.
# There is no default for any of them.

# REQUIRED. Shared with PostgREST through PGRST_JWT_SECRET in ../postgrest.conf.
# Minimum 32 characters; bootstrap throws if it is shorter. There is no default
# and there must never be one — a committed fallback would sign tokens that
# nothing else accepts.
JWT_SECRET=

# Database coordinates. No defaults: a missing key is an error, not a guess.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=app_dev

# Read by the PostgREST process, not by the thin app. PGRST_JWT_SECRET must hold
# the same value as JWT_SECRET above — the thin app refuses to boot if the two
# diverge, rather than issuing tokens the API layer would reject.
#
# There is deliberately NO PGRST_DB_URI here. PostgREST's database URI is composed
# by scripts/dev.mjs and scripts/prod.mjs from DB_HOST, DB_PORT, DB_NAME and
# AUTHENTICATOR_PASSWORD above, always as the pgrst_authenticator role — the one
# role that owns no table and is a member of app_anon/app_member/app_admin.
# A hand-written URI is how the data layer broke once already: the shipped value
# named `app`, the migration/owner role, which bypasses its own RLS and cannot
# `SET ROLE` at all, so every request failed with
# 42501 permission denied to set role "app_anon" while GET / still answered 200.
# A committed file must not carry a credential, and two copies of one password
# drift apart; there is one source of truth and it is AUTHENTICATOR_PASSWORD.
PGRST_JWT_SECRET=

# Optional. The thin app listens here; the Angular SSR server uses 4000.
PORT=3000

# REQUIRED. LOGIN password of the pgrst_authenticator role, which BOTH the thin
# app's login path (SET LOCAL ROLE app_admin inside one transaction) and PostgREST
# connect as. Required in every mode; there is no default, and a wrong one fails
# as `password authentication failed for user "pgrst_authenticator"` on every
# login — so `npm run db:seed` sets it, and re-run that rather than editing it.
AUTHENTICATOR_PASSWORD=

# The application's own public origin. REQUIRED in every mode, no default: every
# email template carries an absolute link, and the previous tree's
# http://localhost:4200 default put a link to the developer's own machine inside
# every message the application ever sent. Must be https in production.
APP_BASE_URL=http://localhost:4000

# Transactional email (src/email). There is ONE transport — nodemailer
# smtpTransport — in every mode; only the destination changes, and it comes from
# configuration alone. In development and test that destination is the local
# SMTP sink: an in-process, loopback-only listener `npm run dev` starts
# (backend/scripts/smtp-sink.ts, imported by scripts/dev.mjs). It stores what it
# accepts and never relays, which is why production may not name a loopback
# EMAIL_HOST — SMTP's 250 is an acknowledgement, not a delivery.
#
# EMAIL_HOST and EMAIL_PORT are REQUIRED in every mode with no default. The sink
# does not authenticate, so EMAIL_USER/EMAIL_PASSWORD are unset here; in
# production they are required with no default (a relay credential is not
# something to invent).
# EMAIL_SECURE defaults to true on port 465 and false elsewhere (STARTTLS).
# EMAIL_FROM defaults to no-reply@<hostname of APP_BASE_URL> outside production.
# APP_NAME defaults to that same host; set it to the name users know.
# EMAIL_TLS_REJECT_UNAUTHORIZED defaults to true and is REFUSED as false in
# production; it exists for the sink's self-signed certificate.
# EMAIL_HOST=127.0.0.1
# EMAIL_PORT=1025
