# Copy to .env and edit. Only *.example files are committed; a real .env holds
# secrets and is git-ignored.
#
# Every value below is read once, in src/config/environment.ts. A missing or
# malformed value stops the process at bootstrap with the full list of problems.
# There is no default for any of them.

# REQUIRED. Shared with PostgREST through PGRST_JWT_SECRET in ../postgrest.conf.
# Minimum 32 characters; bootstrap throws if it is shorter. There is no default
# and there must never be one — a committed fallback would sign tokens that
# nothing else accepts.
JWT_SECRET=

# Database coordinates. No defaults: a missing key is an error, not a guess.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=app_dev

# Read by the PostgREST process, not by the thin app. PGRST_JWT_SECRET must hold
# the same value as JWT_SECRET above — the thin app refuses to boot if the two
# diverge, rather than issuing tokens the API layer would reject.
PGRST_DB_URI=postgresql://app:app@localhost:5432/app_dev
PGRST_JWT_SECRET=

# Optional. The thin app listens here; the Angular SSR server uses 4000.
PORT=3000
