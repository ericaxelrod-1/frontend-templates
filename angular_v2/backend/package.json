{
  "name": "backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Thin NestJS application server. PostgREST serves the CRUD API layer.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "nest build",
    "typecheck": "tsc --noEmit --incremental false -p tsconfig.json",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.mjs\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "lint": "eslint . && npm --prefix ../frontend run lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.config.e2e.ts",
    "test:rls": "vitest run --config vitest.config.rls.ts",
    "smoke": "vitest run --config vitest.config.smoke.ts",
    "verify": "node scripts/verify.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-fastify": "^12.0.1",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.11.10",
    "@vitest/coverage-v8": "^4.1.2",
    "eslint": "^10.11.0",
    "eslint-plugin-rxjs-angular": "^2.0.1",
    "globals": "^17.13.0",
    "prettier": "^3.4.2",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.71.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.2"
  },
  "overrides": {
    "eslint-plugin-rxjs-angular": {
      "eslint": "$eslint"
    }
  }
}
