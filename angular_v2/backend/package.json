{
  "name": "backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Thin NestJS application server. PostgREST serves the CRUD API layer.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "nest build",
    "dev": "node scripts/dev.mjs",
    "prod": "node scripts/prod.mjs",
    "typecheck": "tsc --noEmit --incremental false -p tsconfig.json",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.mjs\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "NODE_ENV=production node dist/main.js",
    "lint": "eslint . && npm --prefix ../frontend run lint",
    "test": "NODE_ENV=test vitest run",
    "test:watch": "NODE_ENV=test vitest",
    "test:e2e": "NODE_ENV=test vitest run --config vitest.config.e2e.ts",
    "test:rls": "NODE_ENV=test vitest run --config vitest.config.rls.ts",
    "smoke": "NODE_ENV=test vitest run --config vitest.config.smoke.ts",
    "verify": "node scripts/verify.mjs",
    "migration:run": "node --experimental-strip-types scripts/migrate.ts",
    "migration:revert": "node --experimental-strip-types scripts/migrate.ts down",
    "db:seed": "node --experimental-strip-types database/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/platform-fastify": "^12.0.1",
    "@nestjs/schedule": "^12.0.2",
    "@nestjs/swagger": "^12.0.2",
    "bcrypt": "^5.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "handlebars": "^4.7.10",
    "nodemailer": "^10.0.16",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/bcrypt": "^5.0.2",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.11.10",
    "@types/smtp-server": "^3.5.13",
    "@vitest/coverage-v8": "^4.1.2",
    "eslint": "^10.11.0",
    "eslint-plugin-rxjs-angular": "^2.0.1",
    "globals": "^17.13.0",
    "prettier": "^3.4.2",
    "selfsigned": "^5.5.0",
    "smtp-server": "^3.19.18",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.71.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.2"
  },
  "overrides": {
    "eslint-plugin-rxjs-angular": {
      "eslint": "$eslint"
    }
  }
}
